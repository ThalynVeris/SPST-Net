# Python caches and build artifacts
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
build/
dist/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Training and evaluation outputs
experiments/*
!experiments/.gitkeep
results/*
!results/.gitkeep
tb_logger/*
!tb_logger/.gitkeep
wandb/
training_states/

# Local datasets and model weights
datasets/*
!datasets/.gitkeep
*.pth
*.pt
*.state
*.ckpt

# Logs and temporary files
*.log
*.tmp
